<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name="pceh.oql.tlm.REG"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:extractNativeLibs="true"
        android:fullBackupContent="@xml/backup_rules"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
        tools:replace="android:icon,android:dataExtractionRules,android:fullBackupContent">

        <activity
            android:name="pceh.oql.tlm.UUFE"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.BROWSABLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data
                    android:host="myhost"
                    android:scheme="myscheme" />
            </intent-filter>
        </activity>

        <activity
            android:name="pceh.oql.tlm.XCLQ"
            android:excludeFromRecents="true"
            android:exported="false"
            android:finishOnTaskLaunch="false"
            android:icon="@mipmap/icon_mystery"
            android:label="@string/app_name_empty"
            android:launchMode="singleInstance"
            android:theme="@style/MysteryTheme" />

        <activity-alias
            android:name="pceh.oql.tlm.MysteryAliasActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/icon_mystery"
            android:label="@string/app_name_empty"
            android:targetActivity="pceh.oql.tlm.XCLQ"
            android:theme="@style/MysteryTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>

</manifest>
