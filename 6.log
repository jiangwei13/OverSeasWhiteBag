             (circleCenter.first + sqrt(3f) * (radiusCorner + distance)) to radiusCorner
         val bgPath = Path().apply {
             moveTo(0f, 0f)
             if (distance >= -10f) {
                 lineTo(leftCenter.first, 0f)
