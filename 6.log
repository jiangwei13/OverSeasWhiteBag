                 viewModel.confirmInputText()
                 CommonUtil.hiddenInputSoft(context, (context as FragmentActivity).currentFocus)
             },
             onHistoryClick = { /* TODO: 启动历史Activity */ }
         )

         Spacer(modifier = Modifier.height(10.dp))

         // 设置区域
         SettingsSection(uiState, viewModel)

     }
 }

 // 控制面板 Composable (方向、播放、录制)
 @Composable
 private fun ControlPanel(
     modifier: Modifier = Modifier,
     scrollType: Int,
     onScrollTypeChange: (Int) -> Unit,
     onPlayClick: () -> Unit,
     onRecordClick: () -> Unit
 ) {
     Card(
         modifier = modifier.fillMaxWidth(),
         shape = RoundedCornerShape(5.dp),
         colors = CardDefaults.cardColors(containerColor = Color(0xFF262626)),
         border = BorderStroke(1.dp, Color(0xFFFF8989))
     ) {
         Row(
             modifier = Modifier
                 .fillMaxWidth()
                 .padding(vertical = 15.dp, horizontal = 12.dp),
             verticalAlignment = Alignment.CenterVertically
         ) {
             // 左滚动按钮
             ControlButton(iconRes = R.mipmap.ic_arrow_left, isSelected = scrollType == 0) { onScrollTypeChange(0) }
             Spacer(modifier = Modifier.width(14.dp))
             // 右滚动按钮
             ControlButton(iconRes = R.mipmap.ic_arrow_right, isSelected = scrollType == 1) { onScrollTypeChange(1) }

             Spacer(modifier = Modifier.weight(1f)) // 占据剩余空间

             // 录制按钮
             ControlButton(iconRes = R.mipmap.ic_record, onClick = onRecordClick)
             Spacer(modifier = Modifier.width(14.dp))
             // 播放按钮
             IconButton(
                 onClick = onPlayClick,
                 modifier = Modifier
                     .size(width = 48.dp, height = 36.dp)
                     .background(Color(0xFF9E00FF), RoundedCornerShape(8.dp))
             ) {
                 Icon(painter = painterResource(id = R.mipmap.ic_play), contentDescription = "Play", tint = Color.White)
             }
         }
     }
 }

 // 文本输入 Composable
 @Composable
 private fun TextInputSection(
     modifier: Modifier = Modifier,
     text: String,
     isError: Boolean,
     onTextChange: (String) -> Unit,
     onConfirmClick: () -> Unit,
     onHistoryClick: () -> Unit
 ) {
     Column(modifier) {
         Text("Aa 文本内容", color = Color.White, fontSize = 18.sp, fontWeight = FontWeight.Bold)
         Spacer(modifier = Modifier.height(5.dp))
         Row(
             verticalAlignment = Alignment.CenterVertically,
             modifier = Modifier.fillMaxWidth()
         ) {
             Icon(
                 painter = painterResource(id = R.mipmap.ic_text),
                 contentDescription = "History",
                 tint = Color.Unspecified,
                 modifier = Modifier.clickable(onClick = onHistoryClick)
             )
             Spacer(modifier = Modifier.width(6.dp))
             OutlinedTextField(
                 value = text,
                 onValueChange = onTextChange,
                 modifier = Modifier.weight(1f),
                 placeholder = { Text("多彩灯光，随心掌控", color = Color.White.copy(alpha = 0.7f))},
                 singleLine = true,
                 isError = isError,
                 colors = TextFieldDefaults.colors(
                     focusedContainerColor = Color(0xFF262626),
                     unfocusedContainerColor = Color(0xFF262626),
                     focusedIndicatorColor = Color(0xFFFF8989),
                     unfocusedIndicatorColor = Color(0xFFFF8989),
                     cursorColor = Color.White,
                     unfocusedTextColor = Color.White,
                     focusedTextColor = Color.White
                 ),
                 shape = RoundedCornerShape(5.dp)
             )
             Spacer(modifier = Modifier.width(6.dp))
             Button(
                 onClick = onConfirmClick,
                 colors = ButtonDefaults.buttonColors(containerColor = Color.Black),
                 shape = RoundedCornerShape(6.dp)
             ) {
                 Text("确定", color = Color.White)
             }
         }
         if (isError) {
             Text(
                 text = "啊哦，内容太长了！",
                 color = MaterialTheme.colorScheme.error,
                 style = MaterialTheme.typography.bodySmall,
                 modifier = Modifier.padding(start = 16.dp, top = 4.dp)
             )
         }
     }
 }


