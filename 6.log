                     sb.append("名称：身份识别失败，请确认证件是否正常\n")
                 } else {
                     sb.append("姓名：" + t.words_result.姓名.words + "\n")
                     sb.append("性别：" + t.words_result.性别.words + "\n")
                     sb.append("名族：" + t.words_result.民族.words + "\n")
                     sb.append("住址：：" + t.words_result.住址.words + "\n")
                     sb.append("出生：：" + t.words_result.出生.words + "\n")
                     sb.append("公民身份证号：" + t.words_result.公民身份号码.words + "\n")
                 }

                 val bean: CurrencyInfoBean =
                     CurrencyInfoBean(sb.toString(), 0, "", "", "", "", "", "")
                 showCurrencyDialog(bean)
             }
         }


         viewMode?.getBackInfoLiveData?.observe(this) { t ->
             loadingDialog?.dismiss()
             val sb = java.lang.StringBuilder()
             sb.append("银行名称：" + t.bank_name + "\n")
             sb.append("银行卡号：" + t.bank_card_number + "\n")
             sb.append("有效期：" + t.valid_date + "\n")
             if (TextUtils.isEmpty(t.holder_name)) {
                 sb.append("持卡人姓名： 未知" + "\n")
             } else {
                 sb.append("持卡人姓名：" + t.holder_name + "\n")
             }
             val bean: CurrencyInfoBean = CurrencyInfoBean(sb.toString(), 0, "", "", "", "", "", "")
             showCurrencyDialog(bean)
         }


         //拍照后走网络识别
         viewMode?.getPicInfoLiveData?.observe(
             this
         ) { t ->
             loadingDialog?.dismiss()
             if (t != null) {
                 if (viewType == VIEW_FROM_BODY_SCAN) {
                     //物体识别
                     BodyScanDetailsActivity.startBodyScanActivity(this, t, currentPic)
                 } else {
                     showTipsDialog(t)
                 }
