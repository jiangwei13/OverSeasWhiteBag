 // 颜色选择器
 @Composable
 fun ColorSelector(
     solidColors: List<ColorBean>,
     gradientColors: List<ColorBean>,
     selectedColor: ColorBean?,
     onColorSelected: (ColorBean) -> Unit
 ) {
     val context = LocalContext.current
     Card(
         modifier = Modifier
             .fillMaxWidth()
             .padding(top = 10.dp),
         shape = RoundedCornerShape(10.dp),
         colors = CardDefaults.cardColors(containerColor = Color.White),
         border = BorderStroke(1.dp, Color.LightGray.copy(alpha = 0.5f))
     ) {
         Column(Modifier.padding(12.dp), verticalArrangement = Arrangement.spacedBy(14.dp)) {
             // 纯色行
             Row(verticalAlignment = Alignment.CenterVertically) {
                 Text(
                     "纯色",
                     fontSize = 12.sp,
                     color = Color(0xFF484848),
                     modifier = Modifier.width(40.dp)
                 )
                 Spacer(modifier = Modifier.width(18.dp))
                 LazyRow(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
                     items(solidColors) { color ->
                         val isSelected =
                             selectedColor?.id == color.id && selectedColor.type == color.type
                         Box(
                             Modifier
                                 .size(24.dp)
                                 .clip(CircleShape)
                                 .background(Color(ContextCompat.getColor(context, color.resId)))
                                 .clickable { onColorSelected(color) }
                                 .then(
                                     if (isSelected) Modifier.border(
                                         2.dp,
                                         Color(0xFF95D3F3),
                                         CircleShape
                                     ) else Modifier
                                 )
                         )
                     }
                 }
             }
             // 渐变色行
             Row(verticalAlignment = Alignment.CenterVertically) {
                 Text(
                     "渐变色",
                     fontSize = 12.sp,
                     color = Color(0xFF484848),
                     modifier = Modifier.width(40.dp)
                 )
                 Spacer(modifier = Modifier.width(18.dp))
                 LazyRow(horizontalArrangement = Arrangement.spacedBy(10.dp)) {
                     items(gradientColors) { color ->
                         val isSelected =
                             selectedColor?.id == color.id && selectedColor.type == color.type
                         val brush = Brush.horizontalGradient(
                             colors = listOf(
                                 Color(ContextCompat.getColor(context, color.startColor)),
                                 Color(ContextCompat.getColor(context, color.endColor))
                             )
                         )
                         Box(
                             Modifier
                                 .size(24.dp)
                                 .clip(CircleShape)
                                 .background(brush)
                                 .clickable { onColorSelected(color) }
                                 .then(
                                     if (isSelected) Modifier.border(
                                         2.dp,
                                         Color(0xFF95D3F3),
                                         CircleShape
                                     ) else Modifier
                                 )
                         )
                     }
                 }
             }
         }
     }
 }


 // 背景样式选择器
 @Composable
 fun BackgroundStyleSelector(
     shapes: List<ShapeBean>,
     selectedShape: ShapeBean?,
     onShapeSelected: (ShapeBean) -> Unit
 ) {
     LazyRow(
         modifier = Modifier.fillMaxWidth(),
         horizontalArrangement = Arrangement.spacedBy(10.dp)
     ) {
         items(shapes) { shape ->
             val isSelected = selectedShape?.id == shape.id
             Box(
                 modifier = Modifier
                     .size(36.dp)
                     .clip(RoundedCornerShape(8.dp))
                     .background(if (isSelected) Color(0xFF95D3F3) else Color.LightGray.copy(alpha = 0.5f))
                     .clickable { onShapeSelected(shape) },
                 contentAlignment = Alignment.Center
             ) {
                 if (shape.res != -1) {
                     Icon(
                         painter = painterResource(id = shape.res),
                         contentDescription = "Shape ${shape.id}",
                         tint = if (isSelected) Color.White else Color.Gray
                     )
                 }
             }
         }
     }
 }

 // 背景图片选择器
 @Composable
 fun BackgroundImageSelector(
     images: List<ColorBean>,
     selectedImage: ColorBean?,
     onImageSelected: (ColorBean) -> Unit
 ) {
     Row(
         modifier = Modifier.fillMaxWidth(),
         verticalAlignment = Alignment.CenterVertically
     ) {
         LazyRow(
             modifier = Modifier.weight(1f),
             horizontalArrangement = Arrangement.spacedBy(8.dp)
         ) {
             items(images) { image ->
                 val isSelected = selectedImage?.id == image.id && selectedImage.type == image.type
                 AsyncImage(
                     model = image.resId,
                     contentDescription = "背景缩略图",
                     modifier = Modifier
                         .width(60.dp)
                         .height(30.dp)
                         .clip(RoundedCornerShape(5.dp))
                         .clickable { onImageSelected(image) }
                         .then(
                             if (isSelected) Modifier.border(
                                 2.dp,
                                 Color(0xFF95D3F3),
                                 RoundedCornerShape(5.dp)
                             )
                             else Modifier
                         ),
                     contentScale = ContentScale.Crop
                 )
             }
         }
         Spacer(Modifier.width(10.dp))
         Icon(
             painter = painterResource(id = R.mipmap.ic_more),
             contentDescription = "更多图片",
             tint = Color.Gray,
             modifier = Modifier.clickable { /* TODO: 启动图片选择Activity */ }
         )
     }
 }


