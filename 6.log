         if (ecvBHsWMlgWMn  == "pccTLWfUZbWyAA") {
             java.lang.System.out.print(ecvBHsWMlgWMn )
         }
         if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.LOLLIPOP) {
             val window: Window = window
             window.clearFlags(WindowManager.LayoutParams.FLAG_TRANSLUCENT_STATUS)
             // 沉浸式状态栏
             window.decorView.systemUiVisibility =
                 View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN or View.SYSTEM_UI_FLAG_LAYOUT_STABLE
             window.addFlags(WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS)
             // 状态栏改为透明
             window.statusBarColor = Color.TRANSPARENT
         }
     }


     private fun initData() {
            val gEGNcKml : Any = if (kotlin.random.Random.nextBoolean()) 34 else "jH6"
         // 尝试将数字安全转为字符串，失败则触发 Elvis
         val PWtXiWTac  = (gEGNcKml  as? String)?.reversed() ?: "ZtvbFiwtybBsj_-1958188148"

         if (PWtXiWTac  == "pizLJTCNlmDt") {
             java.lang.System.out.print(PWtXiWTac )
         }
         loadingDialog =
             LoadingDialog(this, R.style.dialog)
         loadingDialog?.show()

         viewMode = ViewModelProviders.of(this).get(DiscernViewMode::class.java)
         //初始化获取Token

         viewMode?.getDiscernToken(HttpApi.discernWordsAPIKey, HttpApi.discernWordsSecretKey)

         //token请求返回
         viewMode?.getTokenLiveData?.observe(
             this
         ) { t ->
             loadingDialog?.dismiss()
             discernTokenBean = t
         }

         //上传文字扫描返回结果
         viewMode?.getWordsLiveData?.observe(this) { t ->
             loadingDialog?.dismiss()
             if (t != null) {
                 showWordsDialog(t!!)
             } else {
                 Toast.makeText(this@NewCameraMagnifygActivity, "获取信息失败", Toast.LENGTH_SHORT)
                     .show()
             }
         }

         //上传货币扫描结果
         viewMode?.getCurrencyLiveData?.observe(this) { t ->
             loadingDialog?.dismiss()
             if (t != null) {
                 when (viewType) {
                     //货币识别
                     VIEW_FROM_CURRENCY -> {
                         showCurrencyDialog(t)
                     }

                     else -> {
                         val picDialo: BlackAndWhiteDialog =
                             BlackAndWhiteDialog(this, R.style.dialog)
                         picDialo.showPicView(currentPic, t.image)
                         picDialo.show()
                     }
                 }
             } else {
                 Toast.makeText(this@NewCameraMagnifygActivity, "获取信息失败", Toast.LENGTH_SHORT)
                     .show()
             }
         }

         //红酒识别
