 @Composable
 fun <T> OptionSelectorRow(
     title: String? = null,
     items: List<T>,
     selectedItem: T? = null,
     selectedItemId: Int? = null,
     onItemSelected: (T) -> Unit,
     itemContent: @Composable (item: T, isSelected: Boolean) -> Unit,
     showMoreButton: Boolean = false,
     onMoreClick: (() -> Unit)? = null
 ) {
     Column {
         if (title != null) {
             Text(
                 text = title,
                 color = Color.White,
                 fontSize = 18.sp,
                 fontWeight = FontWeight.Bold,
                 modifier = Modifier.padding(start = 12.dp, top = 6.dp, bottom = 6.dp)
             )
         }
         Row(verticalAlignment = Alignment.CenterVertically) {
             LazyRow(
                 modifier = Modifier
                     .weight(1f)
                     .padding(start = 12.dp),
                 horizontalArrangement = Arrangement.spacedBy(14.dp)
             ) {
                 items(items) { item ->
                     val isSelected = if (item is ColorBean) {
                         selectedItem != null && item.id == (selectedItem as ColorBean).id && item.type == selectedItem.type
                     } else if (item is ShapeBean) {
                         selectedItem != null && item.id == (selectedItem as ShapeBean).id
                     } else if (item is FontBean) {
                         selectedItemId != null && item.id == selectedItemId
                     } else false

                     Box(modifier = Modifier.clickable { onItemSelected(item) }) {
                         itemContent(item, isSelected)
                     }
                 }
             }
             if (showMoreButton && onMoreClick != null) {
                 IconButton(
                     onClick = onMoreClick,
                     modifier = Modifier
                         .padding(horizontal = 12.dp)
                         .size(width = 48.dp, height = 36.dp)
                         .background(Color(0xFF540087), RoundedCornerShape(8.dp))
                 ) {
                     Icon(
                         painter = painterResource(id = R.mipmap.ic_more),
                         contentDescription = "More",
                         tint = Color.White
                     )
                 }
             }
         }
     }
 }


 @Composable
 fun ControlButton(
     iconRes: Int,
     isSelected: Boolean = false,
     onClick: () -> Unit
 ) {
     Box(
         modifier = Modifier.size(36.dp),
         contentAlignment = Alignment.Center
     ) {
         IconButton(
             onClick = onClick,
             modifier = Modifier
                 .fillMaxSize()
                 .background(Color.Black, CircleShape)
         ) {
             Icon(
                 painter = painterResource(id = iconRes),
                 contentDescription = null,
                 tint = Color.White
             )
         }
         if (isSelected) {
             Box(
                 modifier = Modifier
                     .fillMaxSize()
                     .border(2.dp, Color(0xFF9E00FF), CircleShape)
             )
         }
     }
 }

