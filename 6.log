 // 文本设置区域
 @Composable
 fun TextSettingsSection(
     uiState: YingyuanUiState,
     viewModel: YingyuanViewModel
 ) {
     val context = LocalContext.current

     // 标题
     SectionTitle(title = "文本设置")
     // 白色圆角卡片
     Card(
         modifier = Modifier
             .fillMaxWidth()
             .padding(horizontal = 20.dp),
         shape = RoundedCornerShape(15.dp),
         colors = CardDefaults.cardColors(containerColor = Color.White),
         elevation = CardDefaults.cardElevation(defaultElevation = 2.dp)
     ) {
         Column(modifier = Modifier.padding(vertical = 20.dp, horizontal = 15.dp)) {
             // 文字内容输入框

             Text(
                 text = "文字内容",
                 fontSize = 16.sp,
                 fontWeight = FontWeight.SemiBold,
                 color = Color(0xFF484848),
                 modifier = Modifier.width(70.dp) // 固定标签宽度，让右侧对齐
             )

             Spacer(modifier = Modifier.height(6.dp))

             BasicTextField(
                 value = uiState.inputText,
                 onValueChange = viewModel::onInputTextChange,
                 // 使用和 OutlinedTextField 相同的文字样式
                 textStyle = TextStyle(
                     color = Color.Black,
                     fontSize = 12.sp,
                 ),
                 // BasicTextField 没有 trailingIcon 参数，我们需要用 decorationBox 手动实现
                 decorationBox = { innerTextField ->
                     Row(
                         // 这个 Box 就是我们的“外壳”，我们可以完全控制它的样式
                         modifier = Modifier
                             .fillMaxWidth()
                             .border(
                                 width = 1.dp, // 边框宽度
                                 color = Color.LightGray, // 边框颜色 (可以根据焦点状态改变)
                                 shape = RoundedCornerShape(8.dp)
                             )
                             // 在这里控制真正的内边距！设置你想要的值
                             .padding(horizontal = 12.dp, vertical = 8.dp),
                         verticalAlignment = Alignment.CenterVertically
                     ) {
                         // `innerTextField` 就是 BasicTextField 的核心输入区域
                         // 将它放置在 Box 内部
                         Box(modifier = Modifier.weight(1f)) {
                             innerTextField()
                             // 如果输入框为空，则显示占位符
                             if (uiState.inputText.isEmpty()) {
                                 Text(
                                     text = "请输入文字内容",
                                     color = Color.Gray,
                                     fontSize = 12.sp
                                 )
                             }
                         }

                         // 在 Box 的末尾添加我们的图标
                         Image(
                             painter = painterResource(id = R.mipmap.ic_ding_main_letter),
                             contentDescription = "确认文字",
                             modifier = Modifier
                                 .padding(start = 2.dp)
                                 .size(16.dp)
                                 .clickable {
                                     viewModel.confirmInputText()
                                     CommonUtil.hiddenInputSoft(
                                         context,
                                         (context as FragmentActivity).currentFocus
                                     )
                                 }
                         )
                     }
                 },
                 // 如果需要单行输入
                 singleLine = true,
                 // 光标颜色
                 cursorBrush = SolidColor(Color.Black)
             )

             // 文字大小
             val fontSizes = listOf("小", "正常", "大", "特大", "巨大")
             SettingRow(label = "文字大小") {
                 SegmentedControl(
                     items = fontSizes,
                     selectedItem = fontSizes[uiState.textSize],
                     onItemSelected = { viewModel.onTextSizeChange(fontSizes.indexOf(it)) }
                 )
             }

             // 文字闪烁
             val blinkSpeeds = listOf("不闪", "快", "更快", "特快", "超快")
             SettingRow(label = "文字闪烁") {
                 SegmentedControl(
                     items = blinkSpeeds,
                     selectedItem = blinkSpeeds[uiState.blinkSpeed],
                     onItemSelected = { viewModel.onBlinkSpeedChange(blinkSpeeds.indexOf(it)) }
                 )
             }

             // 滚动方向
             SettingRow(label = "滚动方向") {
                 ScrollDirectionControl(
                     // 0: 右->左, 1: 左->右.  UI设计与代码逻辑相反，这里做适配
                     selectedDirection = if (uiState.scrollType == 0) "Left" else "Right",
                     onDirectionSelected = { direction ->
                         viewModel.onScrollTypeChange(if (direction == "Left") 0 else 1)
                     }
                 )
             }

             // 播放速度
             val playSpeeds = listOf("更慢", "慢", "正常", "快", "更快")
             SettingRow(label = "播放速度") {
                 SegmentedControl(
                     items = playSpeeds,
                     selectedItem = playSpeeds[uiState.speed],
                     onItemSelected = { viewModel.onSpeedChange(playSpeeds.indexOf(it)) }
                 )
             }

             // 文字颜色
             SettingRow(label = "文字颜色") {
                 // 这个空的Box是为了让下面的ColorSelector能撑满整行
                 Box {}
             }
             ColorSelector(
                 solidColors = uiState.textColorOptions,
                 gradientColors = uiState.textGradientColorOptions,
                 selectedColor = uiState.selectedTextColor,
                 onColorSelected = viewModel::onTextColorSelected
             )
         }
     }
 }

