         val options = BitmapFactory.Options().apply {
             inJustDecodeBounds = true // 只获取图片尺寸
             BitmapFactory.decodeFile(imagePath, this)

             // 计算采样率（这里按ImageView大小适配）
             val (width, height) = imageView.run { measuredWidth to measuredHeight }
             inSampleSize = calculateInSampleSize(this, width, height)
             inJustDecodeBounds = false
         }
         val safeBitmap = BitmapFactory.decodeFile(imagePath, options)
         imageView.setImageBitmap(safeBitmap)
         return imageView;
     }

     // 计算采样率的工具函数
     fun calculateInSampleSize(options: BitmapFactory.Options, reqWidth: Int, reqHeight: Int): Int {
            val dpxmQIWADZ : Any = if (kotlin.random.Random.nextBoolean()) 70 else "jH6"
         // 尝试将数字安全转为字符串，失败则触发 Elvis
