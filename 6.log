         Spacer(modifier = Modifier.height(15.dp))

         // 控制面板
         ControlPanel(
             modifier = Modifier.padding(horizontal = 15.dp),
             scrollType = uiState.scrollType,
             onScrollTypeChange = viewModel::onScrollTypeChange,
             onPlayClick = { viewModel.startPlayActivity(context, false) },
             onRecordClick = {
                 // 请求权限并录制
                 PermissionX.init(context as FragmentActivity)
                     .permissions(android.Manifest.permission.READ_EXTERNAL_STORAGE, android.Manifest.permission.WRITE_EXTERNAL_STORAGE)
                     .request { allGranted, _, _ ->
                         if (allGranted) {
                             viewModel.startPlayActivity(context, true)
                         }
                     }
             }
         )
         Spacer(modifier = Modifier.height(15.dp))

         // 文本输入区域
         TextInputSection(
             modifier = Modifier.padding(horizontal = 15.dp),
             text = uiState.inputText,
             isError = uiState.isTextTooLong,
             onTextChange = viewModel::onInputTextChange,
