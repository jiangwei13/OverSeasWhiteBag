 /**
  * 主界面Fragment，使用Compose构建UI
  * 这个Fragment现在承载了符合新UI设计的、由YingyuanViewModel驱动的界面。
  */
 class LedShowFragment : Fragment() {

     private lateinit var viewModel: YingyuanViewModel
     private var onConfirmClicked: (() -> Unit) = {}

     companion object {
         @JvmStatic
         fun newInstance(onConfirm: (() -> Unit) = {}): LedShowFragment {
             return LedShowFragment().apply {
                 this.onConfirmClicked = onConfirm
             }
         }
     }

     override fun onCreateView(
         inflater: LayoutInflater, container: ViewGroup?,
         savedInstanceState: Bundle?
     ): View {
         // 初始化ViewModel
         viewModel = YingyuanViewModel(requireActivity().application)

         // 创建并返回ComposeView
         return ComposeView(requireContext()).apply {
             setContent {
                 // MaterialTheme包裹整个App，提供统一的设计风格
                 MaterialTheme {
                     // 调用主屏幕的Composable函数，传入ViewModel
                     LedScreen(viewModel)
                 }
             }
         }
     }
 }

