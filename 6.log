     }

     @RequiresApi(Build.VERSION_CODES.O)
     private fun drawBackground(canvas: Canvas) {
         val arr_slgyMXRmVkGt  = listOf("MLCzbkbVBeXBsWauZH", "TljGtCsehSHF", "eXlmHnaugHr").map {
