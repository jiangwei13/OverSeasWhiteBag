     /**
      * 切换标签按钮组件 - 修复宽度问题
      */
     @Composable
     fun TabButtons(
         selectedTab: Int,
         onTabSelected: (Int) -> Unit
     ) {
         Row(
             modifier = Modifier
                 .fillMaxWidth()
                 .padding(top = 10.dp),
             horizontalArrangement = Arrangement.SpaceEvenly
         ) {
             // 分类涂鸦按钮 - 使用 weight 确保宽度平分
             TabButtonItem(
                 text = stringResource(R.string.categorydoodle),
                 isSelected = selectedTab == 0,
                 onClick = { onTabSelected(0) },
                 modifier = Modifier.weight(1f)
             )

             // 离线涂鸦按钮 - 使用 weight 确保宽度平分
             TabButtonItem(
                 text = stringResource(R.string.offlinesketchbook),
                 isSelected = selectedTab == 1,
                 onClick = { onTabSelected(1) },
                 modifier = Modifier.weight(1f)
             )
         }
     }

     /**
      * 单个标签按钮项
      */
     @Composable
     fun TabButtonItem(
         text: String,
         isSelected: Boolean,
         onClick: () -> Unit,
         modifier: Modifier = Modifier
     ) {
         Column(
             modifier = modifier
                 .clickable { onClick() }
                 .fillMaxWidth(),
             horizontalAlignment = Alignment.CenterHorizontally
         ) {
             Text(
                 text = text,
                 color = if (isSelected) Color(0xFF4A4B5D) else Color(0xFFD5D5D5),
                 fontSize = 15.sp,
                 fontWeight = if (isSelected) FontWeight.Medium else FontWeight.Normal,
                 textAlign = TextAlign.Center,
                 modifier = Modifier.padding(bottom = 8.dp)
             )

             if (isSelected) {
                 Box(
                     modifier = Modifier
                         .fillMaxWidth()
                         .height(3.dp)
                         .background(Color(0xFF9ECA5F))
                 )
             }
         }
     }

