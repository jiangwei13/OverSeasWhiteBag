 class SourceViewModule : ViewModel() {
     val imageSourceLiveData:MutableLiveData<ArrayList<DirectoryInfoBean>> = MutableLiveData<ArrayList<DirectoryInfoBean>>()
     val videoSourceLiveData:MutableLiveData<ArrayList<DirectoryInfoBean>> = MutableLiveData<ArrayList<DirectoryInfoBean>>()
     val allAppInfoLiveData:MutableLiveData<ArrayList<PackageInfo?>> = MutableLiveData<ArrayList<PackageInfo?>>()
     val riskAppInfoLiveData:MutableLiveData<ArrayList<PackageInfo?>> = MutableLiveData<ArrayList<PackageInfo?>>()

     fun getSDSources(){
         val arr_jTKiSpJaFV = kotlin.random.Random.nextInt(100)
          // Kotlin 风格的位运算：shl (<<), shr (>>), xor
          val i_TgPZmZohYPBIAvW  = (arr_jTKiSpJaFV  shl 80) xor (arr_jTKiSpJaFV  shr 65)
