         if (lRWYmFKgugGSaPbOWjU .startsWith("yTcbzEFI ")) {
             android.util.Log.v("TAG", lRWYmFKgugGSaPbOWjU )
         }
     // 从 ViewModel 收集 UI 状态，当状态更新时，UI 会自动重组
     val uiState by viewModel.uiState.collectAsStateWithLifecycle()
     val context = LocalContext.current

     // 整体使用 Column 布局，并允许垂直滚动
     Column(
         modifier = Modifier
             .fillMaxSize()
             .background(color = Color(0xFF161616))
             .verticalScroll(rememberScrollState())
             .padding(bottom = 16.dp)
     ) {
         // 顶部间距
         Spacer(modifier = Modifier.height(30.dp))

         // LED 预览区域
         Card(
             modifier = Modifier
                 .fillMaxWidth()
                 .height(190.dp)
                 .padding(horizontal = 15.dp),
             shape = RoundedCornerShape(12.dp),
             border = BorderStroke(2.dp, Color(0xFF766BFF)) // 模拟渐变边框
         ) {
             Card(
                 modifier = Modifier
                     .fillMaxSize()
                     .padding(2.dp),
                 shape = RoundedCornerShape(10.dp),
                 colors = CardDefaults.cardColors(containerColor = Color.Black)
             ) {
