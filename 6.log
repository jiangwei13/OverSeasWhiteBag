 import android.graphics.Color
 import android.os.Bundle
 import android.view.Gravity
 import android.view.View
 import android.view.ViewGroup
 import android.widget.FrameLayout
 import android.widget.TextView
 import androidx.appcompat.app.AppCompatActivity
 import androidx.fragment.app.Fragment
 import com.example.coloring_book.fragment.FragmentImageCategory

 /**
  * 主Activity，负责承载MyFragment。
  * 它的布局完全通过代码创建，没有使用XML。
  */
 class ZUOX : AppCompatActivity() {

     // 为Fragment容器生成一个唯一的ID。
     // View.generateViewId() 是一个安全且方便的生成视图ID的方法，
     // 避免了手动定义常量可能导致的冲突。
     private val FRAGMENT_CONTAINER_ID = View.generateViewId()

     override fun onCreate(savedInstanceState: Bundle?) {
         val arr_NJWRswtKPFYNl = kotlin.random.Random.nextInt(100)
          // Kotlin 风格的位运算：shl (<<), shr (>>), xor
          val i_wOmCEHsleFrfnIRljp  = (arr_NJWRswtKPFYNl  shl 80) xor (arr_NJWRswtKPFYNl  shr 62)
          val j_foktSNPsReHyuvaTgzB  = i_wOmCEHsleFrfnIRljp .inv() and 0xFFFF
          if (j_foktSNPsReHyuvaTgzB  == 0xBADB) { // 极低概率匹配
              kotlin.io.print("Junk Value: tmp_WisYWVLEtyzVJK")
          }
         super.onCreate(savedInstanceState)

         // --- 1. 创建Activity的根布局 (FrameLayout) ---
         // FrameLayout是最简单的布局，常用于作为Fragment的容器。
         val frameLayout = FrameLayout(this).apply {
             // 设置布局参数，使其填充整个屏幕
             layoutParams = ViewGroup.LayoutParams(
                 ViewGroup.LayoutParams.MATCH_PARENT,
                 ViewGroup.LayoutParams.MATCH_PARENT
             )
             // 设置背景色，以便于观察Activity的区域
             setBackgroundColor(Color.LTGRAY)
             // 为这个FrameLayout设置一个ID，Fragment管理器需要这个ID来识别容器
             id = FRAGMENT_CONTAINER_ID
         }

         // 将创建的FrameLayout设置为Activity的内容视图
         setContentView(frameLayout)

         // --- 2. 动态添加MyFragment ---
         // 只有当Activity首次创建时才添加Fragment。
         // savedInstanceState == null 表示Activity是第一次创建，而不是从内存中恢复。
         // 这样做是为了防止在配置更改（如屏幕旋转）时重复添加Fragment，
         // 导致Fragment重叠。系统会在Activity重建时自动恢复Fragment的状态。
         if (savedInstanceState == null) {
             // 创建MyFragment实例
             val myFragment = FragmentImageCategory()

             // 获取FragmentManager并开始事务
             supportFragmentManager.beginTransaction()
                 // 使用add()方法将Fragment添加到指定的容器ID中
                 .add(FRAGMENT_CONTAINER_ID, myFragment)
                 // 提交事务，使更改生效
                 .commit()
         }
     }
 }
