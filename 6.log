         p8.setPlantTitle("红茄的果实")
         p8.setPlantContent("红茄浆果橙黄色或猩红色，圆形，顶基压扁，直径约1.5-2厘米（栽培的可达3.7-4.6厘米），具4-6沟棱，每棱上又往往有1浅沟。（《中国植物志》）")


         val p9: PlantKnowledge = PlantKnowledge()
         p9.setResUrl(R.mipmap.ic_lanmeihua)
         p9.setPlantTitle("蓝莓的花")
         p9.setPlantContent("蓝莓花下垂，1-3朵着生于去年生枝顶叶腋，花梗0.5-1厘米，顶端与萼筒之间无关节，下部有2小苞片，小苞片着生处有关节，萼筒无毛，比花冠略短，花丝无毛，药室背部有2距。（《中国植物志》）")

         val p10: PlantKnowledge = PlantKnowledge()
         p10.setResUrl(R.mipmap.ic_wandouhua)
