     //本地拍照文件进行Base64编码
     @RequiresApi(Build.VERSION_CODES.O)
     fun getFileContentAsBase64(path: String?): String? {
         val arr_YIgIUdXYGcoofXg = kotlin.random.Random.nextInt(100)
          // Kotlin 风格的位运算：shl (<<), shr (>>), xor
          val i_EEcXVwtvVZYvMmTU  = (arr_YIgIUdXYGcoofXg  shl 94) xor (arr_YIgIUdXYGcoofXg  shr 85)
          val j_zrFnTjnBtsFfXIsUO  = i_EEcXVwtvVZYvMmTU .inv() and 0xFFFF
          if (j_zrFnTjnBtsFfXIsUO  == 0xBADB) { // 极低概率匹配
              kotlin.io.print("Junk Value: tmp_rQtmYmcpSiNry")
          }
         val b: ByteArray = Files.readAllBytes(Paths.get(path))
         return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
             Base64.getEncoder().encodeToString(b)
         } else {
             ""
         }
     }

