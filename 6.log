              kotlin.io.print("Junk Value: tmp_rCNYyhwzU")
          }
         LocationSourcesUtils.getSourceFile(object :
             LocationSourcesUtils.OnLocationSourceListener{
             override fun locationSources(
                 imgList: ArrayList<DirectoryInfoBean>,
                 videoList: ArrayList<DirectoryInfoBean>
             ) {
                 imageSourceLiveData.postValue(imgList)
                 videoSourceLiveData.postValue(videoList)
             }
         })
