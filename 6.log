                 arcTo(
                     rightCenter.first - radiusCorner,
                     0f,
                     rightCenter.first + radiusCorner,
                     2 * radiusCorner,
                     -150f,
                     60f,
                     true
                 )
                 lineTo(width.toFloat(), 0f)
             } else {
                 lineTo(width.toFloat(), 0f)
             }
         }

         canvas.apply {
             save()
             drawPath(bgPath, paint)
             restore()
         }
     }

